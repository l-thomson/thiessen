class Sampler:
    def __init__(
        self,
        config_json: str,
        x: npt.NDArray[np.float64],
        y: npt.NDArray[np.float64],
        seed: int,
    ) -> None: ...
    @staticmethod
    def aft(
        config_json: str,
        x: npt.NDArray[np.float64],
        times: npt.NDArray[np.float64],
        events: npt.NDArray[np.bool_],
        seed: int,
    ) -> Sampler: ...
    @staticmethod
    def interval_censored(
        config_json: str,
        x: npt.NDArray[np.float64],
        lower: npt.NDArray[np.float64],
        upper: npt.NDArray[np.float64],
        seed: int,
    ) -> Sampler: ...
    @property
    def n_kept(self) -> int: ...
    @property
    def config(self) -> str: ...
    def step(self, n: int) -> None: ...
    def keep(self) -> None: ...
    def set_response(self, y: npt.NDArray[np.float64]) -> None: ...
    def set_aft_response(
        self, times: npt.NDArray[np.float64], events: npt.NDArray[np.bool_]
    ) -> None: ...
    def set_interval_censored_response(
        self, lower: npt.NDArray[np.float64], upper: npt.NDArray[np.float64]
    ) -> None: ...
    def fitted_values(self) -> npt.NDArray[np.float64]: ...
    def noise_variances(self) -> npt.NDArray[np.float64]: ...
    def finish(self) -> Fitted: ...

